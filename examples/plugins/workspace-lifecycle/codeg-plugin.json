{
  "apiVersion": 2,
  "id": "codeg.workspace-lifecycle",
  "name": "Workspace Lifecycle",
  "version": "1.0.0",
  "server": { "entry": "workspace.mjs", "methods": [] },
  "client": { "entry": "events.html" },
  "contributes": {
    "settingsPanel": { "id": "events", "title": "Workspace Events" },
    "lifecycleHooks": [
      { "event": "workspace.open.before", "method": "before-open" },
      { "event": "workspace.open.after", "method": "after-open" },
      { "event": "workspace.close.after", "method": "after-close" },
      { "event": "session.turn.completed", "method": "turn-completed" }
    ]
  }
}
