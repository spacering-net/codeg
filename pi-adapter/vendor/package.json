{
  "name": "@spacering/pi-acp",
  "version": "0.1.0",
  "description": "ACP adapter for the pi coding agent: a fork of pi-acp for pi 1.0, maintained for codeg",
  "license": "MIT",
  "author": "xintaofei",
  "contributors": [
    "Sergii Kozak <svkozak@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xintaofei/pi-acp.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/xintaofei/pi-acp/issues"
  },
  "homepage": "https://github.com/xintaofei/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter",
    "codeg"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --silent && node dist/index.js",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/preflight-publish.mjs && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "cross-spawn": "7.0.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
